# PostgreSQL connection used by the API and migrations.
# Development default matches docker-compose.yml.
DATABASE_URL=postgres://pickup:pickup@localhost:5434/pickup_counter

# Dedicated database for integration tests (real PostgreSQL, not mocks).
TEST_DATABASE_URL=postgres://pickup:pickup@localhost:5434/pickup_counter_test

# Shared HMAC-SHA256 secret for payment webhooks. Change in any non-local environment.
# The sender script and API must use the same value. Never commit a production secret.
WEBHOOK_SECRET=dev-webhook-secret-change-me

# Stock hold duration for unpaid orders, in seconds.
HOLD_SECONDS=120

# API listen port.
PORT=3000

# Public origin of the API as seen by the browser (used at frontend build time).
VITE_API_URL=http://localhost:3000
